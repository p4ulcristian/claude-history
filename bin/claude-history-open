#!/bin/bash
# SUPER+A: open the Claude History widget, focus it, or close it when it already has focus.
# Its own hostname gives the window its own class (chrome-claude-history.localhost__-Default), so a Hyprland
# window rule can float, centre and size it without touching other local web apps.
systemctl --user is-active -q claude-history || systemctl --user start claude-history
addr=$(hyprctl clients -j | jq -r '.[] | select(.class | startswith("chrome-claude-history.localhost")) | .address' | head -n1)
if [[ -z $addr ]]; then
  exec omarchy-launch-webapp "http://claude-history.localhost:4470/"
elif [[ $(hyprctl activewindow -j | jq -r .address) == "$addr" ]]; then
  hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null
else
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
fi
